Options -Indexes

<IfModule mod_dir.c>
  # 1. Matikan auto-redirect DirectorySlash agar Apache/LiteSpeed tidak melakukan 301 redirect ke trailing slash pada direktori prerender
  DirectorySlash Off
  DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
  # Mengaktifkan mesin penulisan ulang (rewrite engine)
  RewriteEngine On

  # 2. KANONIKALISASI: Redirect www ke non-www dan paksa HTTPS
  RewriteCond %{HTTP_HOST} ^www\.exaque\.com$ [NC]
  RewriteRule ^(.*)$ https://exaque.com/$1 [L,R=301]
  
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. KANONIKALISASI TRAILING SLASH:
  # Redirect URL yang memiliki trailing slash ke URL tanpa trailing slash (kecuali direktori aset dan root)
  RewriteCond %{REQUEST_URI} !^/(assets|10th|hubfs|video|admin)/
  RewriteCond %{REQUEST_URI} ^/(.+)/+$
  RewriteRule ^ /%1 [R=301,L]

  # 4. Sajikan file statis fisik langsung jika ada (css, js, gambar, xml, txt, dll)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5. PRIORITAS PRERENDER: Sajikan file .html statis jika ada (contoh: /sistem-manajemen-antrian -> sistem-manajemen-antrian.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 6. PRIORITAS PRERENDER FOLDER: Sajikan folder/index.html jika ada (contoh: /sistem-manajemen-antrian -> sistem-manajemen-antrian/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 7. Fallback SPA untuk rute dinamis React Router
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Memaksa file .rss dibuka sebagai XML di browser (Safari/Chrome) agar tidak diminta download aplikasi RSS
  <FilesMatch "\.rss$">
    Header set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>

    # 3. SECURITY HEADERS (Sesuai Prioritas 3)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data:;"
</IfModule>

<IfModule mod_deflate.c>
    # 4. GZIP COMPRESSION (Performa Lighthouse)
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    # 5. BROWSER CACHING (Performa Lighthouse)
    ExpiresActive On
    ExpiresByType image/jpg "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/gif "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType text/css "access plus 6 months"
    ExpiresByType application/javascript "access plus 6 months"
</IfModule>
